<?xml version="1.0" encoding="utf-8"?>
<!--
  ITsquad app launcher foreground – "IT" speech-bubble mark
  Derived from the brand logo SVG. Colors: cyan #25A9E0 on transparent.
  Fits inside the 108×108 dp adaptive-icon safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:width="108dp"
    android:height="108dp">

    <!-- Scale and center the logo mark in the adaptive-icon viewport -->
    <group
        android:pivotX="75.5"
        android:pivotY="51"
        android:scaleX="0.88"
        android:scaleY="0.88"
        android:translateX="-21.5"
        android:translateY="3">

        <!-- Speech-bubble outline -->
        <path
            android:pathData="M45,18 L106,18 L106,74 L78,74 L74,84 L68,74 L45,74 Z"
            android:strokeColor="#25A9E0"
            android:strokeWidth="4.5"
            android:strokeLineJoin="miter"
            android:fillColor="#00000000" />

        <!-- Letter I (vertical bar) -->
        <path
            android:pathData="M56,30 L66,30 L66,63 L56,63 Z"
            android:fillColor="#25A9E0" />

        <!-- Letter T -->
        <path
            android:pathData="M71,30 L98,30 L98,38 L89,38 L89,63 L80,63 L80,38 L71,38 Z"
            android:fillColor="#25A9E0" />
    </group>
</vector>